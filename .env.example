# Bybit market data environment (public requests; API keys not required for PAPER)
BYBIT_ENV=mainnet
# Optional: reserved for future read-only private API diagnostics; never used for orders
BYBIT_API_KEY=
BYBIT_API_SECRET=
# LAN access; do not forward this port on router. For SSH-only set HOST=127.0.0.1
HOST=0.0.0.0
PORT=8090
# Optional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
